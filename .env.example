# Brand identity for the Shark fork. Copy to `.env` and edit; the TUI, CLI and
# server read this file at startup (Bun/Node surfaces). The static logo SVGs
# and i18n strings are branded separately — run `bun run script/rebrand.ts`
# when changing the product name to update those too.

# Product name (shown in terminal titles, banners, dialogs, installers, menus)
BRAND_NAME=Shark

# Short prefix used in terminal title bars and status badges (e.g. "OC |")
BRAND_SHORT=SK

# Organization/team credited for building the product (model identity answers)
# BRAND_ORG=SUJA

# Long window/app title (defaults to BRAND_NAME when unset)
# BRAND_TITLE=
#
# Product tagline used in splash/onboarding copy
# BRAND_TAGLINE=The open source AI coding agent.
#
# Character index where the two-tone colored wordmark splits
# (defaults to roughly half the name; "Shark" -> "SHA"|"RK")
# BRAND_SPLIT=3